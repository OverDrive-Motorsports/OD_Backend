erDiagram
  User {
    string id PK
    string email UK
    string displayName
    string passwordHash
    datetime createdAt
    datetime updatedAt
  }

  AuthSession {
    string id PK
    string userId FK
    string refreshTokenHash
    datetime expiresAt
    datetime createdAt
  }

  Provider {
    string id PK
    string code UK
    string name
    string status
    datetime createdAt
  }

  Championship {
    string id PK
    string providerId FK
    string code
    string name
    string category
    boolean isActive
    datetime createdAt
    datetime updatedAt
  }

  ProviderConnection {
    string id PK
    string userId FK
    string providerId FK
    json configJson
    datetime createdAt
    datetime updatedAt
  }

  UserPreset {
    string id PK
    string userId FK
    string name
    boolean isDefault
