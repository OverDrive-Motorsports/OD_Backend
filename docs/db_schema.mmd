  User ||--o{ AuthSession : has
  User ||--o{ ProviderConnection : configures
  User ||--o{ UserPreset : owns

  Provider ||--o{ ProviderConnection : provides
  Provider ||--o{ Championship : owns
  Provider ||--o{ Event : schedules
