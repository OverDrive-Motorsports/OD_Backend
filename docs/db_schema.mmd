  Session ||--o{ RacePositionSample : ranks
  Session ||--o{ RaceIntervalSample : gaps
  Session ||--o{ RaceStint : stints
  Session ||--o{ RacePitStop : pits
  Session ||--o{ RaceControlEvent : controls
  Session ||--o{ TeamRadioMessage : radios
  Session ||--o{ RaceWeatherSample : weather
  Session ||--o{ SessionResultRow : results
  Session ||--o{ StartingGridRow : grid
