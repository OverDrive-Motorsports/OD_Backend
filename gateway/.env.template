# Copy to gateway/.env. The gateway always loads this file, including under Docker Compose,
# where the variables set by the compose file take precedence over it.
# Secrets have no default: fill them with the same values as the root .env.
HTTP_PORT=3000
APP_VERSION=dev
GATEWAY_AUTH_TOKEN=
AUTH_JWT_SECRET=
GATEWAY_RATE_LIMIT_RPS=10
GATEWAY_RATE_LIMIT_BURST=20
GATEWAY_TRUSTED_PROXIES=
AUTH_SERVICE_URLS=http://localhost:3001
USER_DATA_SERVICE_URLS=http://localhost:3002
CHAMPIONSHIP_SERVICE_URLS=http://localhost:3003
RACE_DATA_SERVICE_URLS=http://localhost:3004
INGESTION_SERVICE_URLS=http://localhost:3005
