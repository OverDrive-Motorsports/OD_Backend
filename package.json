{
  "name": "overdrive-backend-prisma",
  "private": true,
  "scripts": {
    "prisma:validate:auth": "prisma validate --schema services/auth-service/resources/schema.prisma",
    "prisma:validate:user-data": "prisma validate --schema services/user-data-service/resources/schema.prisma",
    "prisma:validate:championship": "prisma validate --schema services/championship-service/resources/schema.prisma",
    "prisma:validate:race-data": "prisma validate --schema services/race-data-service/resources/schema.prisma",
    "prisma:validate:active": "npm run prisma:validate:championship && npm run prisma:validate:race-data",
    "prisma:validate:all": "npm run prisma:validate:active"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  }
}
