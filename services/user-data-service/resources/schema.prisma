datasource db {
  provider = "postgresql"
  url      = env("USER_DATA_DATABASE_URL")
}

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
}

//-------------------------
// External Provider Links
//-------------------------
model ProviderConnection {
  id         String   @id @default(uuid())
  userId     String
  providerId String
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

//-------------------------
// User Layout Presets
//-------------------------
// A preset is one saved AR/VR layout. `data` is the layout document produced by the client
// (widgets, positions, sizes, settings...) stored as-is: the backend only checks it is a
// bounded JSON object and never interprets its content.
model UserPreset {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(50)
  isDefault Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
