# Local run of this service outside Docker (`go run`). Docker Compose reads the root .env instead.
# Secrets have no default: fill them with the same values as the root .env.
HTTP_PORT=3005
APP_VERSION=dev
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT=10s
OPENF1_RETRIES=2
OPENF1_RETRY_DELAY=800ms
RACE_DATA_SERVICE_URL=http://localhost:3004
CHAMPIONSHIP_SERVICE_URL=http://localhost:3003
INTERNAL_INGESTION_TOKEN=
# Optional: OpenF1 account for live data, both or neither. Under Compose, or when the root .env
# defines these keys (even empty), set them in the root .env: it is read first.
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_TOKEN_URL=https://api.openf1.org/token
# Optional: live job tuning, see doc/openf1-live-access.md.
OPENF1_LIVE_POLL_INTERVAL=3s
OPENF1_LIVE_GRACE=30m
OPENF1_LIVE_MAX_FAILURES=20
OPENF1_LIVE_MAX_JOBS=1
