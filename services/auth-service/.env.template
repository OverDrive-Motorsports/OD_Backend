# Local run of this service outside Docker (`go run`). Docker Compose reads the root .env instead.
# Secrets have no default: fill them with the same values as the root .env.
HTTP_PORT=3001
APP_VERSION=dev
AUTH_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/overdrive_auth?schema=public
AUTH_JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
