# Copy to .env (gitignored) and fill every empty value before `docker compose up`.
# Secrets have no default on purpose: the services refuse to start with an empty or weak value.
# Generate each secret with:  openssl rand -hex 32
# (hex on purpose: base64 output contains "/" and "+", which break the database URLs built
# from POSTGRES_PASSWORD in docker-compose.yml)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Static token of the gateway: internal / scripted calls only (admin routes), never shipped in a
# client app. At least 32 bytes.
GATEWAY_AUTH_TOKEN=
GATEWAY_RATE_LIMIT_RPS=10
GATEWAY_RATE_LIMIT_BURST=20
# Optional: comma-separated IPs/CIDRs of reverse proxies in front of the gateway. Only their
# X-Forwarded-For is used to identify clients for rate limiting. Leave empty without a proxy.
GATEWAY_TRUSTED_PROXIES=

# Signs and verifies user access tokens (auth-service, gateway, user-data-service). At least 32 bytes.
AUTH_JWT_SECRET=

# Shared by ingestion-service, championship-service and race-data-service to protect
# POST /internal/ingestion/batches. At least 32 bytes.
INTERNAL_INGESTION_TOKEN=

# Optional OpenF1 account of ingestion-service (live data needs a paid OpenF1 subscription): set
# both or leave both empty for anonymous access to historical data.
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Optional: token endpoint of OpenF1 (default https://api.openf1.org/token), https only.
OPENF1_TOKEN_URL=
# Optional live job tuning, see services/ingestion-service/doc/openf1-live-access.md.
OPENF1_LIVE_POLL_INTERVAL=
OPENF1_LIVE_GRACE=
OPENF1_LIVE_MAX_FAILURES=
OPENF1_LIVE_MAX_JOBS=

# Optional Google sign-in of auth-service: leave the three empty to disable it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# Optional: tag of the images docker compose builds and runs (default: local).
OVERDRIVE_IMAGE_TAG=
